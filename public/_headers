# Cloudflare Pages / Netlify header rules

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# ── While you're still building ──────────────────────────────
# Short caches, so a photo or a CSS tweak shows up on the next reload
# instead of days later. Costs a little speed, saves a lot of confusion.

/photos/*
  Cache-Control: public, max-age=300, must-revalidate

/css/*
  Cache-Control: public, max-age=300, must-revalidate

# Listed one by one on purpose: `/js/*` also matches `/js/vendor/*`, and
# Cloudflare applies BOTH rules and concatenates them rather than taking the
# most specific one. That gave Three.js two conflicting max-age values.
/js/main.js
  Cache-Control: public, max-age=300, must-revalidate

/js/gallery3d.js
  Cache-Control: public, max-age=300, must-revalidate

# Three.js is a pinned version and never changes — cache it hard.
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable


# ── At launch ────────────────────────────────────────────────
# Once the photos and copy are settled, replace the four blocks above
# (keep the vendor one as-is) with these. Repeat visits get much faster.
# Still no bare `/js/*` — it would collide with the vendor rule again.
#
